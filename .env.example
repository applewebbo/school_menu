ACCOUNT_DEFAULT_HTTP_PROTOCOL=http
DEBUG=on
SECRET_KEY=change_me_as_soon_as_possible
ALLOWED_HOSTS=*
ENABLE_SCHOOL_DATE_CHECK=False
COOLIFY_WEBHOOK_URL=https://your-coolify-instance/api/v1/deploy/webhook
COOLIFY_WEBHOOK_TOKEN=your_coolify_webhook_token_here
REDIS_HOST=your_redis_host_here
OVH_S3_ACCESS_KEY=your_access_key_here
OVH_S3_SECRET_KEY=your_secret_key_here
OVH_S3_BUCKET_NAME=django-db-backup
OVH_S3_ENDPOINT_URL=https://s3.eu-south-mil.io.cloud.ovh.net
OVH_S3_REGION=eu-south-mil

# AI MENU IMPORT (#234) - site-wide Gemini key, not per user
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Defaults to true when a key is set; set to False to hide the feature without removing
# the key (the upload modal then accepts CSV only, exactly as before).
AI_MENU_IMPORT_ENABLED=True
# Daily caps: per user, and overall. Keep the global one just below the model's RPD
# (free tier, checked in AI Studio: Flash Lite = 500 RPD, full Flash = 20 RPD).
AI_MENU_IMPORT_USER_DAILY_LIMIT=10
AI_MENU_IMPORT_GLOBAL_DAILY_LIMIT=250
# Cron of the nightly retention run; apply it with `manage.py setup_ai_import_schedule`
AI_MENU_IMPORT_PURGE_SCHEDULE=30 3 * * *
